{
  "manifest_version": 3,
  "name": "RepoVibe — GitHub Themes",
  "short_name": "RepoVibe",
  "version": "0.1.0",
  "description": "Give every GitHub repository a different vibe. Local, private themes with a live visual editor.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "action": { "default_title": "RepoVibe", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"} },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["shared/core.js", "content.js"],
    "run_at": "document_start"
  }],
  "options_page": "studio.html",
  "minimum_chrome_version": "114"
}
